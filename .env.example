DJANGO_SECRET_KEY=dev-insecure-change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_LOG_LEVEL=INFO
# Set to 1 only behind a TLS-terminating proxy.
DJANGO_TRUST_PROXY_HEADERS=0
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_SECURE_COOKIES=0
DJANGO_SECURE_HSTS_SECONDS=0
USE_POSTGRES=0
# Prefer DATABASE_URL in managed hosting; it wins over the POSTGRES_* variables.
DATABASE_URL=
POSTGRES_DB=order_to_audit
POSTGRES_USER=ota_user
POSTGRES_PASSWORD=ota_password
POSTGRES_HOST=db
POSTGRES_PORT=5432
REDIS_URL=
SEED_DEMO_DATA=1
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0
